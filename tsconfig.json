{
  "extends": "./tsconfig.base.json",
  "include": [],
  // The root no longer owns any source — the worker lives in
  // packages/hono-worker, the frontend in packages/frontend. This root
  // tsconfig exists only so editor tooling resolves tsconfig.base.json for
  // the workspace. Each package has its own tsconfig.json that extends base.
  "exclude": ["node_modules", "packages", "frontend", "dist"]
}
