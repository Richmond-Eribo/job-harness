# =========================================================================
# Frontend (TanStack Start) environment.
#
# Vite exposes VITE_* vars to the client bundle via import.meta.env. Copy this
# to `.env` (gitignored) for local dev; set the same var as a build-time input
# in CI/deploy.
# =========================================================================

# The REST API origin this frontend talks to. The browser calls it cross-origin
# with credentials (the session cookie lives on the API origin, SameSite=None).
# Dev runs the worker on :8787.
VITE_API_URL="http://localhost:8787"
