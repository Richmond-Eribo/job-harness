{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Frontend Worker — the standalone TanStack Start app.
  // Cloudflare origin, separate from the Hono REST API worker
  // (packages/hono-worker). The browser calls the API cross-origin via
  // VITE_API_URL with credentials; auth cookies live on the API origin.
  //
  // `main` is the virtual server entry TanStack Start provides; the Cloudflare
  // vite plugin resolves it at build time into .output/server/index.js.
  "name": "job-agent-web",
  // 2026-07-21 is the newest compatibility date the repo's pinned local
  // workerd runtime supports (2026-07-24 booted fine when DEPLOYED but broke
  // `vite dev`'s embedded miniflare with ERR_RUNTIME_FAILURE). Bump this (and
  // the wrangler/workerd pins) together when upgrading.
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",

  // Custom domain — the public web origin. Requires richmonderibo.dev to be
  // a zone in the same Cloudflare account (DNS record auto-created). The
  // GitHub workflow bakes VITE_API_URL into the bundle at build time — set
  // the repo secret to https://api-job-agent.richmonderibo.dev.
  "routes": [
    { "pattern": "job-agent.richmonderibo.dev", "custom_domain": true },
  ],

  // Serve ONLY on the custom domain — the *.workers.dev subdomain would
  // render but its API calls would fail CORS (only the custom origins are
  // trusted by the API worker).
  "workers_dev": false,

  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true, // optional, default = true
      "head_sampling_rate": 1, // optional, default = 1
    },
    "traces": {
      "enabled": true, // automatic tracing, open beta
    },
  },
}
