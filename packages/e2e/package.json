{
  "name": "@agent-harness/e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end integration tests (Playwright) that drive the whole project — frontend + API worker, real browser, real LLM.",
  "scripts": {
    "seed": "node scripts/seed-users.mjs",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e": "playwright test",
    "e2e:fast": "playwright test --grep-invert @llm",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
