{
  // Agent Harness — v1 (Cloudflare FREE plan)
  // ------------------------------------------
  // Durable Objects (SQLite-backed) + cron only. NO containers, NO sandbox.
  // Free-tier Workers plan supports DOs + the cron trigger watchdog.
  // See docs for the v2 (paid plan) variant which adds a Sandbox container
  // for code execution.
  "name": "agent-harness",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // Only MAX_STEPS is kept as a Worker var. Model identity (provider/model/url)
  // and generation params live in src/config/llm-config.json — NOT here. The API key
  // is a real secret set via `wrangler secret put LLM_API_KEY`.
  // CAPTURE_TRACE is the non-secret on/off for reasoning capture (detailed
  // caps live in src/config/observability-config.json).
  "vars": {
    "MAX_STEPS": "100",
    "CAPTURE_TRACE": "1",
  },

  // Workers AI binding. Optional in v1 (harness calls the BYOK model via the
  // AI SDK). Powers the planned v2 path: route through env.AI without an
  // external API key. The binding is present now so schema/infra doesn't need
  // to change when we flip.
  "ai": {
    "binding": "AI",
  },

  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true, // optional, default = true
      "head_sampling_rate": 1, // optional, default = 1
    },
    "traces": {
      "enabled": true, // automatic tracing, open beta
    },
  },

  // NOTE: no `assets` binding — this worker serves NO static files. The UI is a
  // separate TanStack Start app (packages/frontend). Any legacy ./public assets
  // are unused after the pure-REST cutover.

  // D1 — global auth/user directory (Better Auth tables). A relational,
  // queryable store is required for the user/session/verification registry
  // that both the Worker and the cron must read (KV can't do relational
  // lookups; per-user DOs can't serve as a global directory). The cron uses
  // this to enumerate users and wake each one's harness.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-harness-auth",
      "database_id": "6c582a13-72b7-42a5-a495-e024f8b41ec0",
      "migrations_dir": "migrations"
    },
  ],

  // R2 — CV/résumé file storage, keyed by userId. Real binary files live here
  // (not base64-in-SQLite); the JobApplicationAgent DO stores only a pointer
  // {r2Key, filename, contentType} in its user_profile table.
  "r2_buckets": [
    {
      "binding": "CV_BUCKET",
      "bucket_name": "agent-harness-cvs",
    },
  ],

  "durable_objects": {
    "bindings": [
      { "name": "HARNESS", "class_name": "Harness" },
      { "name": "JOB_AGENT", "class_name": "JobApplicationAgent" },
      // Browser capability — reaches login-walled job sites (Indeed/LinkedIn)
      // via the user's real Chrome (extension relay, free-tier) or the managed
      // headless Chromium (paid plan, see BROWSER binding below).
      { "name": "BROWSER_RELAY", "class_name": "BrowserRelay" },
      { "name": "BROWSER_AGENT", "class_name": "BrowserAgent" },
      // Global rate limiter — a SINGLE instance guards the shared LLM_API_KEY
      // across all users (sliding-window counter + per-user buckets) and enforces
      // the per-user active-run limit. See src/agents/rate-limiter.ts.
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
    ],
  },

  // Managed headless browser (@cloudflare/playwright). OPTIONAL — uncomment on
  // the paid Workers plan to enable the always-available sessionless target.
  // When absent, the relay targets the extension (live) target only.
  // "browser": { "binding": "BROWSER" },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Harness",
        "JobApplicationAgent",
      ],
    },
    {
      "tag": "browser",
      "new_sqlite_classes": ["BrowserRelay", "BrowserAgent"],
    },
    {
      // Drop the ResearchAgent DO. Removed_sqlite_classes deletes the class's
      // backing SQLite namespace on deploy. Run once per environment.
      "tag": "drop-research",
      "removed_sqlite_classes": ["ResearchAgent"],
    },
    {
      // Global rate limiter DO — guards the shared LLM_API_KEY across all
      // users and enforces the per-user active-run limit. Single instance.
      "tag": "auth-multi-tenant",
      "new_sqlite_classes": ["RateLimiter"],
    },
  ],

  "triggers": {
    "crons": ["*/2 * * * *"],
  },
}
