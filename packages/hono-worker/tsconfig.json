{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  // worker-configuration.d.ts (generated by `wrangler types`) is deliberately
  // NOT included here: its literal-typed Cloudflare.Env conflicts with our
  // hand-written Env (string-typed vars). The generated file is for editor
  // intellisense on `env.*`; runtime binding correctness is verified by
  // `wrangler deploy --dry-run`. Matches the pre-monorepo behaviour where the
  // referenced env.d.ts was never committed/generated during tsc.
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // Test files use Node globals (require/__dirname) that vitest provides at
  // runtime. They're type-checked & run by vitest, not tsc, so exclude them
  // here to keep `tsc --noEmit` focused on the Workers app source only.
  // auth.cli.ts + cli-schema.ts are dev tooling for @better-auth/cli (Node-only
  // imports like better-sqlite3); excluded from the Worker typecheck for the
  // same reason — they're never bundled into the Worker.
  "exclude": [
    "node_modules",
    "src/test",
    "src/auth/auth.cli.ts",
    "migrations/cli-schema.ts"
  ]
}
