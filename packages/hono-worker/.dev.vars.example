# =========================================================================
# Copy to .dev.vars (local dev) or set via `wrangler secret put <NAME>` (prod).
#
# This is the source of truth for all environment-bound configuration that
# CANNOT live in version control because it's secret (credentials) or
# environment-specific.
#
# Non-secret knobs live in:
#   - src/config/llm-config.json           (provider, model, generation params)
#   - src/config/observability-config.json (trace capture toggles)
#   - wrangler.jsonc vars                  (MAX_STEPS, CAPTURE_TRACE)
# =========================================================================

# --- LLM ---
# Secret only. Provider/model/url + generation params live in src/config/llm-config.json.
# Get a key from https://z.ai.com/ (GLM) or swap provider in llm-config.json + key here.
LLM_API_KEY=""

# --- Dashboard ---
# Legacy shared bearer token. Replaced by session-cookie auth (Better Auth) in
# Stage 4; kept only for the /legacy dashboard during the cutover. Optional.
# Pick any opaque random string.
DASHBOARD_TOKEN=""

# --- Auth (multi-tenant) ---
# Secret used to sign/verify Better Auth session cookies + browser-relay
# extension tokens. Generate one: `openssl rand -hex 32`
AUTH_SECRET=""

# Resend API key for magic-link delivery. Get one at https://resend.com/api-keys
# When left empty, magic links are LOGGED to the console + surfaced via a
# dev-only response header (no email sent) — handy for local dev.
RESEND_API_KEY=""

# Public base URL of the API deployment. Better Auth uses it to build absolute
# callback URLs and as a trusted CORS origin. For local dev use the wrangler URL.
BETTER_AUTH_URL="http://localhost:8787"

# Public base URL of the STANDALONE frontend (TanStack Start), served from a
# SEPARATE origin. This is added to Better Auth's trustedOrigins and to the CORS
# allowlist so the cross-origin SPA can call /api/* with credentials. Empty = no
# separate frontend (old same-origin SPA mode). Dev runs TanStack Start on :3000.
FRONTEND_URL="http://localhost:3000"

# Sender address for OTP emails (read by src/auth/auth.ts → resend.ts).
# MUST be a Resend-verified sender (verify your domain at resend.com/domains).
# Without this, magic links fall back to console-logging instead of emailing.
MAIL_FROM="agent@example.com"

# --- Forward-looking (sendmail tool — Phase 2, NOT yet wired) ---
# When MAIL_ALLOWLIST is empty, the sendmail tool returns needs_approval but
# never transports anything. Set this to enable real delivery in a future phase.
# MAIL_ALLOWLIST="you@example.com,recruiter@acme.com"
