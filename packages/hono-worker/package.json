{
  "name": "@agent-harness/hono-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.workers.config.ts",
    "db:generate": "better-auth generate --config src/auth/auth.cli.ts --output ./migrations/cli-schema.ts --yes",
    "db:migrate:local": "wrangler d1 migrations apply agent-harness-auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply agent-harness-auth --remote"
  },
  "dependencies": {
    "@agent-harness/shared-types": "*",
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "agents": "^0.17.3",
    "ai": "^7.0.22",
    "better-auth": "^1.6.23",
    "cron-parser": "^5.6.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.28",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^4.20250620.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
