{
  // Agent Harness — v1 (Cloudflare FREE plan)
  // ------------------------------------------
  // Durable Objects (SQLite-backed) + cron only. NO containers, NO sandbox.
  // Free-tier Workers plan supports DOs + the cron trigger watchdog.
  // See docs for the v2 (paid plan) variant which adds a Sandbox container
  // for code execution.
  "name": "agent-harness",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // Only MAX_STEPS is kept as a Worker var. Model identity (provider/model/url)
  // and generation params live in src/config/llm-config.json — NOT here. The API key
  // is a real secret set via `wrangler secret put LLM_API_KEY`.
  // CAPTURE_TRACE is the non-secret on/off for reasoning capture (detailed
  // caps live in src/config/observability-config.json).
  "vars": {
    "MAX_STEPS": "100",
    "CAPTURE_TRACE": "1",
  },

  // Workers AI binding. Optional in v1 (harness calls the BYOK model via the
  // AI SDK). Powers the planned v2 path: route through env.AI without an
  // external API key. The binding is present now so schema/infra doesn't need
  // to change when we flip.
  "ai": {
    "binding": "AI",
  },

  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true, // optional, default = true
      "head_sampling_rate": 1, // optional, default = 1
    },
    "traces": {
      "enabled": true, // automatic tracing, open beta
    },
  },

  // Static dashboard assets (CSS + client JS) served by the platform from ./public.
  // Keeps HTML payload small and lets browsers cache the assets independently.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },

  "durable_objects": {
    "bindings": [
      { "name": "HARNESS", "class_name": "Harness" },
      { "name": "RESEARCH_AGENT", "class_name": "ResearchAgent" },
      { "name": "JOB_AGENT", "class_name": "JobApplicationAgent" },
      // Browser capability — reaches login-walled job sites (Indeed/LinkedIn)
      // via the user's real Chrome (extension relay, free-tier) or the managed
      // headless Chromium (paid plan, see BROWSER binding below).
      { "name": "BROWSER_RELAY", "class_name": "BrowserRelay" },
      { "name": "BROWSER_AGENT", "class_name": "BrowserAgent" },
    ],
  },

  // Managed headless browser (@cloudflare/playwright). OPTIONAL — uncomment on
  // the paid Workers plan to enable the always-available sessionless target.
  // When absent, the relay targets the extension (live) target only.
  // "browser": { "binding": "BROWSER" },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Harness",
        "ResearchAgent",
        "JobApplicationAgent",
      ],
    },
    {
      "tag": "browser",
      "new_sqlite_classes": ["BrowserRelay", "BrowserAgent"],
    },
  ],

  "triggers": {
    "crons": ["*/2 * * * *"],
  },
}
