{
  "name": "Job-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @agent-harness/hono-worker run dev",
    "dev:web": "npm --workspace @agent-harness/frontend run dev",
    "dev:worker": "npm run dev:api",
    "dev:frontend": "npm run dev:web",
    "build:api": "npm --workspace @agent-harness/hono-worker exec wrangler -- deploy --dry-run",
    "build:web": "npm --workspace @agent-harness/frontend run build",
    "build:frontend": "npm run build:web",
    "build": "npm run build:web && npm run build:api",
    "deploy:api": "npm --workspace @agent-harness/hono-worker run deploy",
    "deploy:web": "npm --workspace @agent-harness/frontend run deploy",
    "deploy": "npm run build:web && npm run deploy:web && npm run deploy:api",
    "tail": "npm --workspace @agent-harness/hono-worker run tail",
    "types": "npm --workspace @agent-harness/hono-worker run types",
    "typecheck": "npm --workspace @agent-harness/frontend run typecheck && npm --workspace @agent-harness/hono-worker run typecheck",
    "test": "npm run test:unit",
    "test:unit": "npm --workspace @agent-harness/hono-worker run test:unit",
    "test:integration": "npm --workspace @agent-harness/hono-worker run test:integration"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}